<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lantianya.aodcoverwallpaper"
    android:versionCode="7"
    android:versionName="4.3">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:theme="@style/Theme.AodCoverWallpaper">

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AodCoverWallpaper.Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
